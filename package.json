{
  "name": "handlesapi",
  "version": "0.1.0",
  "description": "Typed, dependency-free TypeScript client for the Handles API: public social media data for X, Instagram, TikTok, YouTube, Telegram, Bluesky, Twitch, Kick and LinkedIn.",
  "license": "MIT",
  "author": "Handles API <support@handlesapi.com> (https://handlesapi.com)",
  "homepage": "https://handlesapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handlesapi/handlesapi-js.git"
  },
  "bugs": {
    "url": "https://github.com/handlesapi/handlesapi-js/issues"
  },
  "keywords": [
    "social-media-api",
    "twitter-api",
    "instagram-api",
    "tiktok-api",
    "youtube-api",
    "openapi",
    "mcp",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/generate.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.*js\"",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
